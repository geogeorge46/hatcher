# Hatcher Cloud Functions Environment / Secrets Reference
# NEVER commit real secrets. Store production secrets in Firebase Secret Manager:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_WEBHOOK_SECRET

TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret-string
