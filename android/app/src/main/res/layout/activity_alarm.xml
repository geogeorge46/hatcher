<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Digital Clock at top -->
    <TextView
        android:id="@+id/tv_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:textColor="#94A3B8"
        android:textSize="36sp"
        android:textStyle="bold"
        android:text="08:30 AM" />

    <!-- Center Container for Symbol and Message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Huge Symbol Card -->
        <TextView
            android:id="@+id/tv_symbol"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="#1E293B"
            android:gravity="center"
            android:text="∆"
            android:textColor="#FBBF24"
            android:textSize="88sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_slot_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ഉച്ചക്കത്തെ റൊട്ടേഷൻ"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Malayalam Alarm Text -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp"
            android:text="മുട്ട തിരിക്കാൻ സമയമായി – ഇപ്പോൾ ∆ വെക്കണം"
            android:textColor="#CBD5E1"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- Big Green Done Button -->
        <Button
            android:id="@+id/btn_rotated"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#2E7D32"
            android:elevation="4dp"
            android:text="തിരിച്ചു ✔  (Rotated)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Snooze Button -->
        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:text="10 മിനിറ്റ് നീക്കിവെക്കൂ  (Snooze)"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>
